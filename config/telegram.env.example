# Copy to data/telegram.env (data/ is ignored). Never commit real values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_APP_URL=https://tour-finder-rose.vercel.app/app
# Use a dedicated local DB during development. Set the production URL only on servers.
DATABASE_URL=sqlite:///data/telegram-local.sqlite
